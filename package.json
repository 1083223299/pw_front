{
  "name": "exchange-project",
  "version": "1.0.0",
  "description": "充值中心桌面端",
  "main": "main.js",
  "scripts": {
    "dev": "cross-env VITE_APP_ENV=test VITE_DESKTOP=true node scripts/dev.js",
    "dev:test": "cross-env VITE_APP_ENV=test VITE_DESKTOP=true node scripts/dev.js",
    "dev:prod-api": "cross-env VITE_APP_ENV=prod VITE_DESKTOP=true node scripts/dev.js",
    "dev:web": "vite --mode development",
    "build": "npm run build:prod",
    "build:test": "cross-env VITE_APP_ENV=test VITE_DESKTOP=true vite build --mode development",
    "build:prod": "cross-env VITE_APP_ENV=prod VITE_DESKTOP=true vite build --mode production",
    "build:web": "npm run build:web:prod",
    "build:web:test": "vite build --mode development",
    "build:web:prod": "vite build --mode production",
    "preview": "vite preview",
    "start": "npm run build:prod && electron .",
    "start:test": "npm run build:test && cross-env VITE_APP_ENV=test electron .",
    "start:prod": "npm run build:prod && electron .",
    "pack": "npm run pack:prod",
    "pack:test": "npm run build:test && cross-env VITE_APP_ENV=test electron-builder --config electron-builder.config.js --dir",
    "pack:prod": "npm run build:prod && cross-env VITE_APP_ENV=prod electron-builder --config electron-builder.config.js --dir",
    "dist": "npm run dist:prod",
    "predist": "node scripts/check-release-lock.js",
    "dist:test": "npm run build:test && node scripts/pack-release.js test",
    "predist:test": "node scripts/clean-unpacked.js",
    "dist:prod": "npm run build:prod && node scripts/pack-release.js",
    "predist:prod": "node scripts/clean-unpacked.js",
    "pack:mac": "npm run build:prod && electron-builder --config electron-builder.config.js --dir --mac",
    "dist:mac": "npm run build:prod && electron-builder --config electron-builder.config.js --mac",
    "gen:icon": "node scripts/gen-icon.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "element-plus": "^2.14.5",
    "node-forge": "^1.3.1",
    "pinia": "^4.0.3",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "cross-env": "^10.1.0",
    "electron": "23.1.3",
    "electron-builder": "^24.13.3",
    "rcedit": "^3.1.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.pwesports.recharge",
    "productName": "pwEsportsRecharge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "notifyBubblePreload.js",
      "localServer.js",
      "api-target.cjs",
      "src/assets/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/icon-mac.png",
      "build/icon.icns",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "充值中心"
    },
    "publish": {
      "provider": "generic",
      "url": "https://weilaidong.oss-cn-beijing.aliyuncs.com/pw-esports-front/"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "notarize": false,
      "extendInfo": {
        "CFBundleDisplayName": "充值中心"
      }
    }
  }
}
